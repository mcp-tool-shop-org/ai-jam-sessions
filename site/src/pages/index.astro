---
import '../styles/global.css';
import BaseLayout from '@mcptoolshop/site-theme/components/BaseLayout.astro';
import Hero from '@mcptoolshop/site-theme/components/Hero.astro';
import Section from '@mcptoolshop/site-theme/components/Section.astro';
import FeatureGrid from '@mcptoolshop/site-theme/components/FeatureGrid.astro';
import DataTable from '@mcptoolshop/site-theme/components/DataTable.astro';
import CodeCardGrid from '@mcptoolshop/site-theme/components/CodeCardGrid.astro';
import ApiList from '@mcptoolshop/site-theme/components/ApiList.astro';
import { config } from '../site-config';
---

<BaseLayout
  title={config.title}
  description={config.description}
  logoBadge={config.logoBadge}
  brandName={config.brandName}
  repoUrl={config.repoUrl}
  npmUrl={config.npmUrl}
  footerText={config.footerText}
  nav={[...config.sections.map(s => ({ href: `#${s.id}`, label: s.title })), { href: '#vocals-today', label: 'Vocals' }]}
>
  <Hero {...config.hero} />

  <section id="piano-roll-showcase" style="max-width:960px;margin:0 auto;padding:2rem 1.5rem 0;text-align:center;">
    <img
      src={`${import.meta.env.BASE_URL}/fur-elise-m1-8.svg`.replace(/\/\//g, '/')}
      alt="Piano-roll visualization of Für Elise measures 1–8 — right hand in blue, left hand in coral, on a deep navy grid"
      style="width:100%;height:auto;border:1px solid #2a2a3e;border-radius:12px;box-shadow:0 8px 40px rgba(0,0,0,0.4);"
      loading="lazy"
    />
    <p style="color:var(--color-muted,#8888aa);font-size:0.9rem;margin-top:0.75rem;">
      <em>How the AI sees music.</em> Für Elise, m.1–8 — the piano roll renders any song as SVG the model can read back and verify.
    </p>
  </section>

  <section id="patriotic-exemplar" style="max-width:960px;margin:0 auto;padding:2.5rem 1.5rem 0;text-align:center;">
    <h2 style="margin-bottom:0.25rem;">A patriotic exemplar</h2>
    <p style="color:var(--color-muted,#8888aa);margin-top:0;">
      <em>America the Beautiful</em> — sourced from the public domain, arranged with the project's own <code>midi-file</code> pipeline, ready for the SoulX-Singer vocal route.
    </p>
    <img
      src={`${import.meta.env.BASE_URL}/america-the-beautiful-m2-6.svg`.replace(/\/\//g, '/')}
      alt="Piano-roll visualization of America the Beautiful measures 2–6, the first phrase of Materna — right hand in blue, left hand in coral, on a deep navy grid"
      style="width:100%;height:auto;border:1px solid #2a2a3e;border-radius:12px;box-shadow:0 8px 40px rgba(0,0,0,0.4);margin-top:1rem;"
      loading="lazy"
    />
    <p style="color:var(--color-muted,#8888aa);font-size:0.9rem;margin-top:0.75rem;">
      Melody: <em>Materna</em> by Samuel A. Ward, 1882 (public domain), checked against a 1919 hymnal and Hymnary.org. Block-chord hymn harmonization generated locally with midi-file. Measures 2–6, the first phrase, in B♭ major at 92 BPM — clean provenance, no third-party arrangement licence uncertainty.
    </p>
  </section>

  <section id="patriotic-vocals" style="max-width:960px;margin:0 auto;padding:2.5rem 1.5rem 0;">
    <h2 style="text-align:center;margin-bottom:0.25rem;">Patriotic vocals, as they stand today</h2>
    <p style="text-align:center;color:var(--color-muted,#8888aa);margin-top:0;">
      <em>America the Beautiful</em> — four SoulX-Singer takes in F major (melody capped at C5 for model comfort), word-level pick, local placement. Recorded 2026-09-29. Honest state, not a demo reel.
    </p>
    <div style="display:grid;gap:1rem;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));margin:1.25rem 0;">
      <div style="border:1px solid #2a2a3e;border-radius:12px;padding:1rem;">
        <div style="font-weight:600;margin-bottom:0.5rem;">The mix — voice over the piano bed</div>
        <audio controls preload="none" style="width:100%;" src={`${import.meta.env.BASE_URL}/audio/america-the-beautiful-vocal-route.mp3`.replace(/\/\//g, '/')}></audio>
      </div>
      <div style="border:1px solid #2a2a3e;border-radius:12px;padding:1rem;">
        <div style="font-weight:600;margin-bottom:0.5rem;">The vocal alone — what the gates measured</div>
        <audio controls preload="none" style="width:100%;" src={`${import.meta.env.BASE_URL}/audio/america-the-beautiful-vocal-only.mp3`.replace(/\/\//g, '/')}></audio>
      </div>
    </div>
    <p style="color:var(--color-muted,#8888aa);font-size:0.95rem;line-height:1.5;">
      <strong>Correction (2026-10-07):</strong> these takes sing the melody of the earlier arrangement, which was not Ward's <em>Materna</em>. The piano roll above is the corrected tune; a whole-song remake on it is in progress.
    </p>
    <p style="color:var(--color-muted,#8888aa);font-size:0.95rem;line-height:1.5;">
      <strong>What is true about this take:</strong> every syllable's pitch, onset and duration come from the song's MIDI on the player's own timeline (the score clock);
      a local, Apache-2.0 score-conditioned singer (SoulX-Singer) sang four takes in F major; the best syllable of each was picked and joined with crossfades;
      then two gates measured the result — <strong>timing</strong>: all 14 syllables within 40 ms of the score (worst 5.6 ms);
      <strong>pitch</strong>: all notes within 50 cents (global offset −5.6 cents, scatter SD 19.9 cents). The voice is the model's example prompt, not a cast one.
      <strong>What is still wrong:</strong> three syllables show WARN (&gt;25 cents): "O" and "beau" sit flat (~−32 cents), "cious" sits sharp (+40 cents). The octave peak was lowered to C5 to keep the model in its sweet spot — a compromise, not a feature.
      Receipts, route and levers: <a href={`${import.meta.env.BASE_URL}/handbook/vocals/`.replace(/\/\//g, '/')}>handbook → Vocals</a>.
    </p>
  </section>

  <section id="vocals-today" style="max-width:960px;margin:0 auto;padding:2.5rem 1.5rem 0;">
    <h2 style="text-align:center;margin-bottom:0.25rem;">Vocals, as they stand today</h2>
    <p style="text-align:center;color:var(--color-muted,#8888aa);margin-top:0;">
      <em>Amazing Grace, mm.1–10 — a real sung line on the piano's clock. Recorded 2026-09-05. Honest state, not a demo reel.</em>
    </p>
    <div style="display:grid;gap:1rem;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));margin:1.25rem 0;">
      <div style="border:1px solid #2a2a3e;border-radius:12px;padding:1rem;">
        <div style="font-weight:600;margin-bottom:0.5rem;">The mix — voice over the piano bed</div>
        <audio controls preload="none" style="width:100%;" src={`${import.meta.env.BASE_URL}/audio/amazing-grace-vocal-route-2026-09-05.mp3`.replace(/\/\//g, '/')}></audio>
      </div>
      <div style="border:1px solid #2a2a3e;border-radius:12px;padding:1rem;">
        <div style="font-weight:600;margin-bottom:0.5rem;">The vocal alone — what the gates measured</div>
        <audio controls preload="none" style="width:100%;" src={`${import.meta.env.BASE_URL}/audio/amazing-grace-vocal-only-2026-09-05.mp3`.replace(/\/\//g, '/')}></audio>
      </div>
    </div>
    <p style="color:var(--color-muted,#8888aa);font-size:0.95rem;line-height:1.5;">
      <strong>Correction (2026-10-07):</strong> this sung line leaves the hymn tune <em>New Britain</em> after its fourth note ("grace how sweet" is sung to the wrong notes). The timing and pitch gates measured it against the same wrong score. A whole-song remake on the corrected tune is in progress.
    </p>
    <p style="color:var(--color-muted,#8888aa);font-size:0.95rem;line-height:1.5;">
      <strong>What is true about this take:</strong> every syllable's pitch, onset and duration come from the song's MIDI on the player's own timeline (the score clock);
      a local, Apache-2.0 score-conditioned singer (SoulX-Singer) sang six takes; the best syllable of each was picked and joined with crossfades;
      then two gates measured the result before it was called a mix — <strong>timing</strong>: every vowel onset within 40 ms of the score (worst 6 ms);
      <strong>pitch</strong>: every note within 50 cents (global offset −2.7 cents). The voice is the model's example prompt, not a cast one.
      <strong>What is still wrong:</strong> the opening still breaks — the pickup "A" and "ma" come from different takes and the splice is audible.
      That is the next handoff, not a feature. Receipts, route and levers:
      <a href={`${import.meta.env.BASE_URL}/handbook/vocals/`.replace(/\/\//g, '/')}>handbook → Vocals</a>.
    </p>
  </section>

  {config.sections.map((s) => (
    <Section id={s.id} title={s.title} subtitle={s.subtitle}>
      {s.kind === 'features' && <FeatureGrid features={s.features} />}
      {s.kind === 'data-table' && <DataTable columns={s.columns} rows={s.rows} />}
      {s.kind === 'code-cards' && <CodeCardGrid cards={s.cards} />}
      {s.kind === 'api' && <ApiList apis={s.apis} />}
    </Section>
  ))}
</BaseLayout>

---
import '../styles/global.css';
import BaseLayout from '@mcptoolshop/site-theme/components/BaseLayout.astro';
import Hero from '@mcptoolshop/site-theme/components/Hero.astro';
import Section from '@mcptoolshop/site-theme/components/Section.astro';
import FeatureGrid from '@mcptoolshop/site-theme/components/FeatureGrid.astro';
import DataTable from '@mcptoolshop/site-theme/components/DataTable.astro';
import CodeCardGrid from '@mcptoolshop/site-theme/components/CodeCardGrid.astro';
import ApiList from '@mcptoolshop/site-theme/components/ApiList.astro';
import Hymns from '../components/Hymns.astro';
import { config } from '../site-config';

const nav = [
  { href: '#listen', label: 'Listen' },
  { href: '#how', label: 'How it was made' },
  { href: '#features', label: 'Features' },
  { href: '#quick-start', label: 'Quick start' },
  { href: '#training-dataset', label: 'Dataset' },
  { href: '#tools', label: 'MCP tools' },
];
const handbook = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}handbook/vocals/`;

// How a take becomes a performance, in the order the pipeline runs.
const steps = [
  {
    title: 'A score clock',
    desc: "Every syllable gets its pitch, its onset and its length from the hymn's own arrangement, on the same timeline the piano plays. Held notes, rests and breaths included.",
  },
  {
    title: 'A sound check first',
    desc: "Before a song is rendered, the same voice sings a sixteen-word calibration phrase at the song's tempo. Its timing footprint, per consonant group and for held against short notes, says how many takes the song needs and which words are risky.",
  },
  {
    title: 'Sixteen takes on a rented GPU',
    desc: "A score-conditioned singer renders each hymn sixteen times on a rented A40 through offrig, so the local card stays free. Each phrase is sung with a second of silence in front, then trimmed, which keeps the model's start-up noise out.",
  },
  {
    title: 'One take per phrase',
    desc: 'A local listener transcribes every phrase of every take without being given the lyrics, and pitch is measured note by note. Each phrase comes whole from the take that was understood best and sung most in tune.',
  },
  {
    title: 'Placed by warping, not cutting',
    desc: 'Each phrase is time-warped onto the score so every vowel lands on its beat, with nothing replayed or skipped inside the phrase. Takes meet only at the rests between phrases.',
  },
  {
    title: 'Two gates, two instruments',
    desc: 'Timing: an energy detector dates each vowel, a singing forced aligner checks it, and a syllable fails only when both say it is off. Pitch: every note is tracked against the score in cents.',
  },
  {
    title: 'A person listens last',
    desc: "The listening review: press M wherever something sounds wrong, and a report joins each mark to the take, the join and the gates at that moment. A listener's ear settles where something sounds off; naming the cause weighs more from training. Its first marks found two defects no gate could see, both fixed at the root. It is moving into the cockpit next.",
  },
];
---

<BaseLayout
  title={config.title}
  description={config.description}
  logoBadge={config.logoBadge}
  brandName={config.brandName}
  repoUrl={config.repoUrl}
  npmUrl={config.npmUrl}
  footerText={config.footerText}
  nav={nav}
>
  <Hero {...config.hero} />

  <Section
    id="listen"
    title="Listen: three hymns, sung on the beat"
    subtitle="Amazing Grace, America the Beautiful and the Battle Hymn of the Republic, every verse, sung by a synthetic voice over piano arrangements written for each hymn. Press play and the score follows the voice."
  >
    <Hymns />
  </Section>

  <Section
    id="how"
    title="How a take becomes a performance"
    subtitle="No single render was good enough on its own. Each performance is assembled from sixteen, and measured before it is called a mix."
  >
    <FeatureGrid features={steps} />
    <p class="how-more">
      The full route, its receipts and what is still imperfect: <a href={handbook}>handbook → Vocals</a>.
    </p>
  </Section>

  {config.sections.map((s) => (
    <Section id={s.id} title={s.title} subtitle={s.subtitle}>
      {s.kind === 'features' && <FeatureGrid features={s.features} />}
      {s.kind === 'data-table' && <DataTable columns={s.columns} rows={s.rows} />}
      {s.kind === 'code-cards' && <CodeCardGrid cards={s.cards} />}
      {s.kind === 'api' && <ApiList apis={s.apis} />}
    </Section>
  ))}
</BaseLayout>

<style>
  .how-more { max-width: 960px; margin: 1.25rem auto 0; color: var(--color-dim); font-size: 0.9rem; text-align: center; }
  .how-more a { color: var(--color-body); text-decoration: underline; }
</style>
